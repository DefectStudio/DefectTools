{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "defect-farm-api-v2",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "v2-local",
    "API_VERSION": "v1",
    "LEASE_SECONDS": "300"
  },
  "secrets": {
    "required": ["SUBMIT_TOKEN", "WORKER_TOKEN", "MANAGER_TOKEN", "VIEWER_TOKEN"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "defect-farm-v2-local",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "migrations"
    }
  ]
}
